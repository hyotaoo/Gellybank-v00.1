# Copy this file to backend/.env and fill in your MySQL details.
#
# DATABASE_URL must be a SQLAlchemy URL in this format:
#   mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Example (local MySQL):
#   DATABASE_URL=mysql+pymysql://root:password@localhost:3306/gellybank

DATABASE_URL=mysql+pymysql://root:password@localhost:3306/gellybank

# Used to sign auth tokens. Change this to a long random string.
SECRET_KEY=change-me-to-a-long-random-string
